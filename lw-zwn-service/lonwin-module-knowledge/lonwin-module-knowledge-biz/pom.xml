<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.lonwin</groupId>
        <artifactId>lonwin-module-knowledge</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lonwin-module-knowledge-biz</artifactId>
    <name>lonwin-module-knowledge-biz</name>
    <description>
        知识模块实现：MinIO 对象存储、达梦元数据、BGE-M3 + Qdrant Hybrid/RRF 检索、文档上传入口。
        阶段 2 的 Word/PDF/Excel 解析器将加入本模块的 parse 包。
    </description>

    <dependencies>
        <!-- 本模块实现的契约 -->
        <dependency>
            <groupId>cn.lonwin</groupId>
            <artifactId>lonwin-module-knowledge-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Result / BaseController / BusinessException / UUIDUtils -->
        <dependency>
            <groupId>cn.lonwin</groupId>
            <artifactId>lonwin-common-core</artifactId>
        </dependency>

        <!--
          文件交互服务仍走 framework-file / common-oss 的 FileTemplate + FileProperties，
          本模块只拥有「知识库侧对外端点」（上传 / 下载 / 预览 / 解析入库），
          不重复实现对象存储客户端。
        -->
        <dependency>
            <groupId>cn.lonwin</groupId>
            <artifactId>lonwin-framework-file</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.lonwin</groupId>
            <artifactId>lonwin-common-oss</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Word / Excel 结构化解析：版本与 knowledge-platform 对齐 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>4.1.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
            <version>4.1.2</version>
        </dependency>
        <!-- PDF 纯文本按页抽取 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.30</version>
        </dependency>

        <!-- Web：@RestController / MultipartFile / RestTemplate -->
        <dependency>
            <groupId>cn.lonwin</groupId>
            <artifactId>lonwin-framework-web</artifactId>
        </dependency>

        <!-- 数据访问：与 lonwin-module-agent 完全一致的三件套，@MapperScan 在 framework-data -->
        <dependency>
            <groupId>cn.lonwin</groupId>
            <artifactId>lonwin-framework-data</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dameng</groupId>
            <artifactId>DmJdbcDriver18</artifactId>
        </dependency>
    </dependencies>
</project>
