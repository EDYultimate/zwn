{
  "name": "lw-idp-platform-frontend",
  "private": true,
  "description": "龙网一体化开发平台前端脚手架",
  "version": "v0.0.1-bate",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen:agent": "node scripts/gen-agent-page-meta.mjs",
    "check:agent": "node scripts/check-agent-contracts.mjs",
    "dev": "npm run gen:agent && vite --mode development",
    "pro": "npm run gen:agent && vite --mode production",
    "build:dev": "npm run gen:agent && vue-tsc --noEmit && npm run check:agent && vite build --mode development",
    "build-noTsc:dev": "npm run gen:agent && vite build --mode development",
    "build:pro": "npm run gen:agent && vue-tsc --noEmit && npm run check:agent && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "eslint src --fix --ext .ts,.tsx,.vue,.js,.jsx",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "@vicons/carbon": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vicons/tabler": "^0.13.0",
    "@vuepic/vue-datepicker": "^14.0.0",
    "@vueuse/core": "^14.3.0",
    "@vxe-ui/plugin-export-xlsx": "4.0.7",
    "axios": "1.15.2",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "dom-zindex": "^1.0.6",
    "echarts": "5.6.0",
    "element-plus": "^2.14.7",
    "element-resize-detector": "1.2.4",
    "exceljs": "4.4.0",
    "js-cookie": "^3.0.5",
    "naive-ui": "^2.44.1",
    "normalize.css": "^8.0.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "6.14.2",
    "vfonts": "^0.0.3",
    "vite-plugin-eslint": "^1.8.1",
    "vue": "3.5.34",
    "vue-router": "^4.6.4",
    "vxe-pc-ui": "^4.6.24",
    "vxe-table": "4.13.37",
    "xe-utils": "3.7.5"
  },
  "devDependencies": {
    "@types/element-resize-detector": "^1.1.6",
    "@types/js-cookie": "^3.0.5",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.21.1",
    "prettier": "^3.2.5",
    "sass": "^1.81.0",
    "terser": "^5.39.0",
    "typescript": "5.9.3",
    "unplugin-auto-import": "^19.1.1",
    "unplugin-vue-components": "^28.4.1",
    "vite": "^6.3.2",
    "vite-plugin-lazy-import": "^1.0.7",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.10"
  },
  "type": "module"
}
