root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{js,jsx,ts,tsx,vue}]
quote_type = single

[*.json]
indent_size = 2
max_line_length = 200

[*.md]
trim_trailing_whitespace = false